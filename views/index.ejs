    }

    label {
      font-weight: bold;
      display: block;
      margin-bottom: 5px;
      color: #ffefae;
      text-align: left;
    }

    input[type="email"],
    input[type="text"],
    input[type="password"] {
      width: 90%;
      padding: 10px;
      margin-bottom: 15px;
      border: none;
      border-radius: 6px;
      font-size: 1em;
    }

